# === INFRASTRUCTURE ===
# Настройки контейнера Postgres (используются Docker'ом при создании)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pikurr_db
POSTGRES_PORT=5432
# Настройки TF Serving
MODEL_NAME=two

# === APPLICATION CONFIG (Pydantic) ===
# Настройки для Python (ETL)
# --- DATABASE ---
# Хост теперь 'db' (имя сервиса из compose)
DB__HOST=db
DB__PORT=5432
DB__USER=${POSTGRES_USER}
DB__PASSWORD=${POSTGRES_PASSWORD}
DB__NAME=${POSTGRES_DB}

# --- PATHS ---
# Внутри контейнера мы смонтировали данные в /data
# DATA_DIR=/data
# Внутри контейнера данные смонтированы в /data_*
PATHS__DATA_INPUT=/data_input
PATHS__DATA_OUTPUT=/data_output

# Пути на ХОСТЕ (диске), чтобы менять их не лазя в yml
#!!! сменить для production!!! 
HOST_INPUT_DIR=./inputs
HOST_OUTPUT_DIR=./outputs
HOST_MODEL_DIR=${HOST_INPUT_DIR}/models
HOST_PG_DATA=${HOST_OUTPUT_DIR}/pg_data


# --- GEE ---
GEE__SERVICE_ACCOUNT='{credentials here}'
GEE__PROJECT='My First Project'

# --- TILE SERVICES ---
TILESERVICES__ESRI=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
TILESERVICES__GOOGLE=https://mt1.google.com/vt/lyrs=s&x={x}&y={y}&z={z}
TILESERVICES__DZZ=https://www.geodzz.by/arcgis/rest/services/georesursDDZ/Belarus_Web_Mercator_new/ImageServer/tile/{z-6}/{y}/{x}

# --- DZZ EXPORT (блочная загрузка geodzz через exportImage) ---
# см. prompts/PROMPT_dzz_export_adapter.md
DZZ__USE_EXPORT=true
DZZ__EXPORT_BASE=https://www.geodzz.by/arcgis/rest/services/georesursDDZ/Belarus_Web_Mercator_new/ImageServer
# Сервер проверяет Referer; подтверждено запросами, что без него отдаёт 401/403/520.
# Внешняя зависимость — может измениться без предупреждения, тогда правится только тут.
DZZ__REFERER=https://www.geodzz.by/izuchdzz/
DZZ__BLOCK_TILES=16
# Общий пул нарезанных тайлов между листами (см. prompts/PROMPT_dzz_export_round3.md, п.1).
# Блок 16x16 почти всегда выходит за границы листа; без пула соседние листы
# перезапрашивают один и тот же блок. false — на случай проблем с местом на
# диске или жёсткими ссылками (например, /data_output на другой ФС).
DZZ__USE_POOL=true
DZZ__PREFER_EXPORT=true
# Снижение нагрузки на ImageServer (см. prompts/PROMPT_dzz_export_round5.md,
# п.5) — не средство от инцидента 10.09 (см. docs/incident-2026-09-10-exportimage-fdo.md),
# тот вызван недоступностью каталога мозаики и от темпа запросов не зависит.
DZZ__BLOCK_WORKERS=1
DZZ__BLOCK_DELAY_MIN=0.5
DZZ__BLOCK_DELAY_MAX=1.5
# Отдых по времени непрерывной работы, а не по числу блоков (уточнённое ТЗ,
# prompts/PROMPT_dzz_export_round5(1).md, п.5): окно работы (мин) выбирается
# случайно из [AFTER_MIN, AFTER_MAX] при каждом срабатывании, длительность
# отдыха (с) — случайно из [REST_MIN, REST_MAX].
DZZ__BLOCK_REST_AFTER_MIN=25
DZZ__BLOCK_REST_AFTER_MAX=35
DZZ__BLOCK_REST_MIN=60
DZZ__BLOCK_REST_MAX=120
# Лимит длительности сессии в минутах — по достижении прогон завершается
# штатно (текущий блок дорабатывается, пул и маркеры остаются согласованными),
# следующий запуск продолжает с этого места за счёт резюмируемости.
# 0 отключает ограничение.
DZZ__SESSION_MAX_MINUTES=150
DZZ__TILE_WORKERS=4
DZZ__TILE_DELAY_MIN=0.1
DZZ__TILE_DELAY_MAX=0.4
# Предохранитель на систематический отказ каталога мозаики (FDO error, Failed
# to execute query, Unable to complete operation) — считаются только отказы на
# различающихся координатах подряд. При достижении порога exportImage
# отключается до конца прогона, остаток идёт через потайловый водопад.
DZZ__EXPORT_FAILURE_THRESHOLD=5

# --- DB TABLES ---
DBTABLES__TRAP=trapeze_serv
DBTABLES__AFIELDS=agrifields
DBTABLES__RAZGR=razgrafka

# --- INFERENCE ---
# Хост теперь 'tf-serving'
INFERENCE__HOST=tf-serving
INFERENCE__PORT=8500
INFERENCE__MODEL_NAME=two
INFERENCE__MODEL_VERSION=1
INFERENCE__BATCH_SIZE=8


TELEGRAM__TOKEN=token_here
TELEGRAM__CHAT_ID=id_here

# --- DELIVERY (rsync пакета на сервер с фронтендом) ---
# Используется PushTask (шаг 9 дашборда) и package_and_push.sh
# Без DELIVERY_HOST шаг 9 пропускается автоматически
DELIVERY_HOST=192.168.251.190
DELIVERY_USER=user
DELIVERY_INBOX=/home/user/repikurr/inbox
# Путь к ключу на ХОСТЕ — монтируется в контейнер как /root/.ssh/id_rsa
DELIVERY_SSH_KEY=~/.ssh/id_rsa