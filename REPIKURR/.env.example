# Секреты для docker-compose.server.yml / docker-compose.vps.yml.
# Скопировать в .env (тот же каталог) и заполнить реальными значениями.
# .env НЕ коммитится (см. .gitignore).
#
# round21, B1: раньше POSTGRES_PASSWORD=pikurr и GEOSERVER_ADMIN_PASSWORD=geoserver
# были захардкожены прямо в docker-compose.server.yml, закоммиченном в публичный
# репозиторий. На локальной сети — неаккуратность, на VPS с доменом — открытая
# админка GeoServer с известным паролем плюс база, слушающая наружу.

POSTGRES_PASSWORD=
GEOSERVER_ADMIN_PASSWORD=

# Порядок смены на уже развёрнутом стенде — см. docs/deploy-repikurr-vps.md,
# раздел "Ротация паролей".

# --- Caddy (round22, задача 1) ---
DOMAIN=geobotany.of.by
ACME_EMAIL=
# Basic auth для /geoserver/web и /geoserver/rest — хеш, не пароль в открытом
# виде. Сгенерировать: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<пароль>'
GEOSERVER_BASIC_AUTH_USER=admin
GEOSERVER_BASIC_AUTH_HASH=
