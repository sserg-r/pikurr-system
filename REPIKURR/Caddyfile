# Caddyfile (round22, задача 1) — заменяет nginx+certbot из round21
# (сохранены в docs/legacy/, не используются).
#
# Caddy сам получает и продлевает сертификаты Let's Encrypt: проверяет срок
# при каждом старте и периодически в фоне — на ежедневно перезапускаемой
# прерываемой ВМ (round22) это устойчивее bootstrap-порядка certbot.
#
# Домен и почта — через переменные окружения контейнера (DOMAIN, ACME_EMAIL,
# см. docker-compose.vps.yml), не хардкод.

{
	email {$ACME_EMAIL}

	# Раунд 22, задача 6: первый прогон — на staging ACME (лимит боевого
	# эндпоинта на неудачные проверки — 5/час/имя, легко исчерпать при
	# отладке проксирования). Раскомментировать на время первого прогона,
	# затем закомментировать обратно И удалить том caddy_data (иначе Caddy
	# останется со staging-сертификатом, недоверенным браузерами) —
	# см. docs/deploy-repikurr-vps.md, раздел "Домен и сертификат".
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# www → каноническое имя (без www). Caddy сам получает сертификат и для
# www.{$DOMAIN} (оба имени в A-записях), редирект — сразу после этого.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode gzip

	# round29, блок D3: журнал доступа — без тел запросов/ответов (Caddy
	# их и не логирует по умолчанию) и без чувствительных заголовков
	# (Authorization/Cookie — единственные реально чувствительные здесь,
	# явно исключены). Ротация — 20 МБ x 5 файлов, тот же принцип, что и
	# у GC-лога GeoServer (round27, B2).
	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 5
		}
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	# HTTP→HTTPS редирект — поведение Caddy по умолчанию для сайта с TLS,
	# специально включать не нужно (подтверждено фактом при проверке, не
	# только по документации — см. отчёт round22, задача 1).

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}

	# round23, задача 1: список годов/районов — статика, не WFS-запрос
	# к GeoServer (тот тянул все 55784+ объектов ради выпадающих списков,
	# ~12с; сам SQL после round22/23-фиксов — миллисекунды, но GeoServer
	# всё равно вытягивает полные строки независимо от propertyName).
	# Файл пишет deliver.py после каждой доставки (REFRESH MATERIALIZED VIEW
	# + пересчёт списков), данные между доставками не меняются — короткий
	# Cache-Control достаточен, не вечный (на случай повторной доставки).
	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=300"
		file_server
	}

	# Админка GeoServer и REST — под basic_auth. Публичному фронтенду не
	# нужны; deliver.py на этом же хосте ходит на geoserver напрямую через
	# 127.0.0.1, минуя Caddy — закрытие здесь не мешает доставке.
	@geoserver_admin path /geoserver/web* /geoserver/rest* /geoserver/gwc/rest*
	handle @geoserver_admin {
		basic_auth {
			{$GEOSERVER_BASIC_AUTH_USER} {$GEOSERVER_BASIC_AUTH_HASH}
		}
		reverse_proxy geoserver:8080
	}

	# Всё остальное под /geoserver/ — WMS/WFS/WMTS/GWC-тайлы, публично
	# (нужно фронтенду для карты).
	#
	# round29, блок D2: GeoServer не выставляет Cache-Control ни на 200,
	# ни на ошибках (round29, D1 — заголовки проверены фактом, пусто) —
	# при отсутствии явной директивы браузер может закэшировать ответ
	# ЭВРИСТИЧЕСКИ, и именно так, по round28 A6, один случайный HTTP 503
	# навсегда "залипал" для fields_latest (там ещё и без cache-buster —
	# исправлено в блоке C, но защита здесь — уровень ниже, на случай
	# любого другого динамического запроса без явного &time=). Ответы с
	# кодом НЕ 200 — Cache-Control: no-store; 200 — поведение не меняется
	# (round28/round29 не нашли оснований трогать успешные ответы).
	handle /geoserver/* {
		reverse_proxy geoserver:8080 {
			@error status 400 401 403 404 405 500 502 503 504
			handle_response @error {
				# round30, блок C (найдено фактом при проверке по
				# содержимому, не только по заголовку — round29
				# проверял только заголовок и пропустил это):
				# handle_response БЕЗ copy_response не пробрасывает
				# исходный ответ апстрима — статус подменяется на 200,
				# тело становится пустым. Баг жил в проде с round29.
				# copy_response восстанавливает статус/тело/заголовки
				# апстрима, header ниже добавляет/переопределяет
				# Cache-Control поверх скопированного ответа.
				copy_response
				header Cache-Control "no-store"
			}

			# round30, блок C2: короткий рестарт GeoServer (порт не
			# слушает первые секунды после docker restart — round29, D3
			# зафиксировал фактом: 30+с полного отказа соединения)
			# раньше давал мгновенный 502 от самого Caddy на каждый
			# запрос в этом окне. lb_try_duration заставляет Caddy
			# повторять попытку дозвониться до апстрима это время,
			# вместо немедленного отказа клиенту.
			#
			# round31, блок E.1: перезамерено на эмуляторе (3×
			# docker restart pikurr_srv_geoserver, до первого валидного
			# ответа WMS GetCapabilities с телом): 13.23с / 12.96с /
			# 13.00с — худший результат 13.23с. Отдельно round30 C.3
			# зафиксировал 21с для сценария `docker compose stop→up`
			# (пересоздание, не просто restart) — это НЕ то же самое,
			# что сегодняшний замер, оба варианта реальны на практике.
			# 30с — запас и над сегодняшним худшим (13.23с, +~127%), и
			# над более тяжёлым историческим сценарием (21с, +~43%).
			# Заведомо НЕ покрывает полный холодный старт (полная
			# инициализация WAR/каталога — минуты, не секунды, round29
			# D3) — тратить на это ожидание каждого клиентского запроса
			# бессмысленно, честно зафиксировано как заведомая граница.
			#
			# Риск: пока Caddy ждёт (до lb_try_duration), запрос клиента
			# ВИСИТ, а не быстро проваливается в 502 — это цена отказа
			# от видимой клиенту ошибки. Под нагрузкой это означает, что
			# КАЖДЫЙ запрос, попавший в окно рестарта, занимает
			# отдельный воркер/горутину Caddy и открытое соединение
			# клиента вплоть до lb_try_duration (а не миллисекунды на
			# мгновенный 502) — при параллельных запросах в момент
			# рестарта они накапливаются одновременно, а не быстро
			# освобождают ресурс отказом. На нынешнем трафике (единицы
			# одновременных пользователей) это не создаёт затора, но при
			# росте нагрузки в окне рестарта может стать местом
			# исчерпания соединений раньше, чем при мгновенном 502.
			lb_try_duration 30s
		}
	}

	# round30, блок C1: Caddy формирует 502 САМ (без обращения к
	# GeoServer), когда апстрим недоступен — round29, D2 нашёл честно,
	# что `handle_response` внутри reverse_proxy это НЕ ловит (он видит
	# только реальные ответы апстрима, не синтетические ошибки самого
	# Caddy при неудачном dial). handle_errors — на уровне всего сайта,
	# перехватывает ЛЮБую ошибку от ЛЮБого обработчика этого домена;
	# сузили матчером именно до /geoserver/*, чтобы не трогать ошибки
	# React-SPA (не было оснований — round29/30 не находили проблем там).
	handle_errors {
		@geoserver_path path /geoserver/*
		header @geoserver_path Cache-Control "no-store"
	}

	# React SPA — всё, что не /geoserver/*.
	handle {
		reverse_proxy react-client:80
	}
}
