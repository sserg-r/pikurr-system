# Шаблон файла окружения уведомлений внешнего мониторинга (round61, блок D).
# Скопировать на стенде в /home/user/repikurr/external_healthcheck.env,
# ЗАПОЛНИТЬ значения, выставить права 600. В git и на носитель с значениями
# не класть. Без файла или без значений уведомления выключены (журнал прежний).
#   install -m 600 /dev/null /home/user/repikurr/external_healthcheck.env
TELEGRAM__TOKEN=
TELEGRAM__CHAT_ID=
# ОБЯЗАТЕЛЬНО на стенде (пути к файлам, не секрет; значения — абсолютные пути): без них
# healthcheck.py не находит вспомогательные файлы, и проверки gwc_layers/filtered_layer красные
# постоянно — в журнале раунда 61 было 6 513 RED. Раскомментировать и вписать пути к
# captured_gwc_urls.json и tiles_with_data.json (на стенде лежат в каталоге support_data рядом
# со скриптами мониторинга).
# CAPTURED_GWC_URLS_PATH=
# TILES_WITH_DATA_PATH=
# Необязательно (значения по умолчанию):
# ALERT_AFTER_FAILS=3
# TELEGRAM_API_URL=https://api.telegram.org
