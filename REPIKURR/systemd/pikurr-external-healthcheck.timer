[Unit]
Description=Таймер: внешний healthcheck витрины PIKURR каждые 5 минут

# round33, блок D.1: интервал 5 минут — компромисс между скоростью
# обнаружения (до этого раунда аварию узнавал только пользователь, открыв
# сайт вручную — без верхней границы задержки) и нагрузкой. Один прогон —
# 4-5 лёгких HTTP-запросов (WMS GetMap 256x256, WFS 1 объект,
# year_district.json, /, /geoserver/nonexistent), сопоставимо по нагрузке
# с одной открытой вкладкой пользователя (round32, блок D измерял вплоть
# до 3 параллельных пользователей без превышения порога ошибок 5%) — раз
# в 5 минут это исчезающе малая добавка к обычному трафику.

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
